<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AI Cricket Simulator</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#080e18;color:#e9eefb;padding:14px 12px 40px;min-height:100vh}
.w{max-width:1000px;margin:0 auto}
h1{text-align:center;font-size:1.35rem;margin-bottom:6px;background:linear-gradient(90deg,#4ade80,#38bdf8);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.sub{text-align:center;color:#8a9bbd;font-size:.76rem;margin-bottom:16px}
.c{background:#121c2e;border:1px solid #243352;border-radius:14px;padding:16px;margin-bottom:14px}
.c h2{font-size:.8rem;text-transform:uppercase;letter-spacing:.5px;color:#38bdf8;margin-bottom:12px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
@media(max-width:640px){.g2{grid-template-columns:1fr}}
.tb{background:#182541;border:1px solid #243352;border-radius:11px;padding:13px}
.tb.a{border-top:3px solid #22c55e}.tb.b{border-top:3px solid #fbbf24}
.th{display:flex;align-items:center;gap:9px;margin-bottom:10px}
.dot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
.dot.a{background:#22c55e;box-shadow:0 0 10px #22c55e}
.dot.b{background:#fbbf24;box-shadow:0 0 10px #fbbf24}
.csel{flex:1;background:#0b1424;border:1px solid #243352;color:#e9eefb;padding:9px 10px;border-radius:8px;font-size:.85rem;font-family:inherit;font-weight:700;outline:none;cursor:pointer}
.tn{width:100%;background:transparent;border:none;border-bottom:1px dashed #243352;color:#e9eefb;font-size:.9rem;font-weight:700;padding:4px 0;outline:none;margin-bottom:10px;font-family:inherit}
