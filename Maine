.cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:9px}
.ch{background:#182541;border:1px solid #243352;border-radius:10px;padding:10px}
.ch .k{font-size:.6rem;color:#8a9bbd;text-transform:uppercase;letter-spacing:.7px;font-weight:700;margin-bottom:3px}
