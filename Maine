.rh{text-align:center;background:linear-gradient(150deg,#0f2a1c,#0c1a2e,#1a1230);border-color:#1f4d38}
.rt{display:inline-block;font-size:.6rem;letter-spacing:2px;color:#22c55e;border:1px solid rgba(34,197,94,.4);border-radius:14px;padding:3px 12px;margin-bottom:10px;text-transform:uppercase;font-weight:800}
.rl{font-size:1.2rem;font-weight:900;margin-bottom:8px;line-height:1.35}
.rl .w{color:#22c55e}.rl .t{color:#fbbf24}
.rs{color:#8a9bbd;font-size:.76rem}
.vs{display:flex;justify-content:center;gap:12px;align-items:center;margin-top:14px;flex-wrap:wrap}
.vt{background:rgba(255,255,255,.05);border:1px solid #243352;border-radius:10px;padding:8px 14px;font-weight:700;font-size:.82rem}
