.sw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.8rem;min-width:380px}
th{text-align:right;padding:8px;font-size:.6rem;color:#8a9bbd;text-transform:uppercase;letter-spacing:.7px;border-bottom:1.5px solid #243352;font-weight:700}
th:first-child{text-align:left}
td{padding:9px 8px;text-align:right;border-bottom:1px solid rgba(36,51,82,.5);font-variant-numeric:tabular-nums}
td:first-child{text-align:left;font-weight:600}
tr.tot td{border-top:2px solid #243352;border-bottom:none;font-weight:900;color:#22c55e;background:rgba(34,197,94,.06)}
.pn{font-size:.63rem;color:#8a9bbd;font-weight:500;display:block;margin-top:1px}
.ih{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:12px;align-items:center}
.ih h3{font-size:.88rem;font-weight:700}
.is{font-size:1.15rem;font-weight:900;font-variant-numeric:tabular-nums}
.is span{font-size:.7rem;color:#8a9bbd;font-weight:600;margin-left:5px}
.cb{margin-top:12px;background:#182541;border:1px solid #243352;border-radius:10px;padding:10px 12px;font-size:.76rem;color:#8a9bbd;display:flex;flex-wrap:wrap;gap:6px 18px}
