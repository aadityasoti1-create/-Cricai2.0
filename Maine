input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:17px;height:17px;background:#fff;border:3px solid #22c55e;border-radius:50%}
.mg{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:11px}
.f{display:flex;flex-direction:column;gap:5px}
.f label{font-size:.66rem;color:#8a9bbd;text-transform:uppercase;font-weight:600}
.f select,.f input{background:#0b1424;border:1px solid #243352;color:#e9eefb;padding:9px;border-radius:8px;font-size:.85rem;font-family:inherit;outline:none}
.sg{display:flex;background:#0b1424;border:1px solid #243352;border-radius:8px;padding:3px;gap:3px}
.sg button{flex:1;background:transparent;border:none;color:#8a9bbd;padding:7px;border-radius:6px;font-weight:700;font-size:.8rem;cursor:pointer;font-family:inherit}
.sg button.on{background:#22c55e;color:#03140b}
.btn{width:100%;margin-top:16px;padding:14px;border:none;border-radius:11px;background:linear-gradient(135deg,#22c55e,#0ea5e9);color:#03140b;font-size:.95rem;font-weight:900;letter-spacing:1px;text-transform:uppercase;cursor:pointer;font-family:inherit}
.btn:disabled{opacity:.5}
.ld{text-align:center;padding:36px 16px}
.bl{width:46px;height:46px;margin:0 auto 14px;border-radius:50%;background:radial-gradient(circle at 34% 30%,#ff5f5f,#b91c1c);animation:bo .6s ease-in-out infinite alternate}
@keyframes bo{from{transform:translateY(-20px)}to{transform:translateY(12px)}}
